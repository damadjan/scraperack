[Unit]
Description=Scraperack management GUI
After=network-online.target scraperack-controller.service
Wants=network-online.target

[Service]
Type=simple
User=scraperack
WorkingDirectory=/opt/scraperack/platform/gui
EnvironmentFile=/etc/scraperack/gui.env
ExecStart=/opt/scraperack/gui-venv/bin/python /opt/scraperack/platform/gui/app.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
