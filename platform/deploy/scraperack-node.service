[Unit]
Description=Scraperack worker node
After=network-online.target scraperack-controller.service scraperack-dns.service
Wants=network-online.target
Requires=scraperack-dns.service
# The node exits when the controller is not up yet (after a reboot, or a worker whose controller
# is another host): keep retrying instead of giving up after systemd's default 5 starts in 10 s.
StartLimitIntervalSec=0

[Service]
User=scraperack
SupplementaryGroups=kvm
EnvironmentFile=/etc/scraperack/node.env
Environment=RUST_LOG=info
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=XTABLES_LOCKFILE=/var/lib/scraperack-node/xtables.lock
ExecStartPre=+/usr/sbin/sysctl -w net.ipv4.ip_forward=1
# Firecracker serves restored guest memory through userfaultfd (memory prefault).
ExecStartPre=+/bin/sh -c 'if [ -e /dev/userfaultfd ]; then chgrp kvm /dev/userfaultfd && chmod 0660 /dev/userfaultfd; fi'
# Pools with huge_pages take 2 MiB pages on demand (a cap, 128 GiB); none are reserved, and
# they go back to the system when the VM exits.
ExecStartPre=+/usr/sbin/sysctl -w vm.nr_overcommit_hugepages=65536
ExecStart=/usr/local/bin/scraperack node --controller ${SCRAPERACK_CONTROLLER} --name ${SCRAPERACK_NODE_NAME} --cpu-millis ${SCRAPERACK_NODE_CPU_MILLIS} --memory-mib ${SCRAPERACK_NODE_MEMORY_MIB} --vm-start-concurrency ${SCRAPERACK_NODE_VM_START_CONCURRENCY} --data-dir /var/lib/scraperack-node --firecracker /usr/local/bin/firecracker --kernel /var/lib/scraperack-node/vmlinux
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
StateDirectory=scraperack-node
Delegate=yes

[Install]
WantedBy=multi-user.target
