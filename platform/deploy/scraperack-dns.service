[Unit]
Description=ScrapeRack node-local DNS proxy
After=network-online.target
Wants=network-online.target

[Service]
User=scraperack
ExecStartPre=+/usr/sbin/ip address replace 10.239.255.254/32 dev lo
ExecStart=/usr/local/bin/dnsproxy --listen=10.239.255.254 --port=53 --upstream=https://cloudflare-dns.com/dns-query --upstream=https://dns.google/dns-query --bootstrap=1.1.1.1:53 --bootstrap=8.8.8.8:53 --upstream-mode=load_balance --cache --cache-size=4194304 --pending-requests-enabled --timeout=10s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
