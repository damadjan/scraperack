#!/usr/bin/python3
"""Scraperack guest agent.

Runs as PID 1 inside every microVM. It is workload-agnostic: the pool tells it,
in the first ``scraperack-snapshot`` request, which extra disks to mount and
which executor command handles task payloads. Executors speak
length-prefixed JSON over ``/tmp/scraperack-executor.sock``.

Each host connection is served on its own thread, so the host can flush disks or
mount a volume while a task runs. Executor requests run one at a time.
"""
import fcntl
import json
import os
import shutil
import socket
import string
import struct
import subprocess
import threading
import time
import traceback
from pathlib import Path

try:
    import ctypes
except ImportError:  # minimal Python builds may lack it
    ctypes = None

EXECUTOR_SOCKET = Path("/tmp/scraperack-executor.sock")
SERVICE = Path("/etc/scraperack-service.json")


def configure_network(payload):
    interface = b"eth0"
    control = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    ifreq = struct.pack("16sh22x", interface, 0)
    flags = struct.unpack("16sh22x", fcntl.ioctl(control, 0x8913, ifreq))[1]
    fcntl.ioctl(control, 0x8914, struct.pack("16sh22x", interface, flags | 1))
    for operation, address in ((0x8916, payload["address"]),
                               (0x891c, str(ipv4_mask(payload["prefix"])))):
        request = struct.pack(
            "16sH2s4s16s",
            interface,
            socket.AF_INET,
            b"\0\0",
            socket.inet_aton(address),
            b"\0" * 16,
        )
        fcntl.ioctl(control, operation, request)
    route = struct.pack("BBBBBBBBI", socket.AF_INET, 0, 0, 0, 254, 4, 0, 1, 0)
    route += netlink_attr(5, socket.inet_aton(payload["gateway"]))
    route += netlink_attr(4, struct.pack("I", socket.if_nametoindex("eth0")))
    message = struct.pack("IHHII", 16 + len(route), 24, 0x505, 1, 0) + route
    with socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, socket.NETLINK_ROUTE) as netlink:
        netlink.send(message)
        response = netlink.recv(4096)
    _, kind, _, _, _ = struct.unpack("IHHII", response[:16])
    if kind == 2:
        error = struct.unpack("i", response[16:20])[0]
        if error:
            raise OSError(-error, os.strerror(-error))
    resolv = Path("/tmp/resolv.conf")
    resolv.write_text("".join(f"nameserver {server}\n" for server in payload["dns"]))
    bind_mount(str(resolv), "/etc/resolv.conf")
    # Resolve the gateway's and DNS server's neighbours now; packets queue until it is done,
    # so there is no need to wait here.
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        probe.sendto(b"\0", (payload["gateway"], 9))
        for server in payload["dns"]:
            probe.sendto(b"\0", (server, 53))


try:
    LIBC = ctypes.CDLL(None, use_errno=True) if ctypes else None
except OSError:
    LIBC = None
MS_BIND = 4096


def bind_mount(source, target):
    """mount --bind without starting a process (fork and exec are slow right after a restore)."""
    if LIBC is None:
        subprocess.run(["mount", "--bind", source, target], check=True)
    elif LIBC.mount(source.encode(), target.encode(), None, MS_BIND, None) != 0:
        error = ctypes.get_errno()
        raise OSError(error, f"bind mount {source} on {target}: {os.strerror(error)}")


def ipv4_mask(prefix):
    return socket.inet_ntoa(struct.pack("!I", (0xffffffff << (32 - prefix)) & 0xffffffff))


def netlink_attr(kind, value):
    length = 4 + len(value)
    return struct.pack("HH", length, kind) + value + b"\0" * ((-length) % 4)


def mount_disks(mounts):
    letters = string.ascii_lowercase[1:]
    if len(mounts) > len(letters):
        raise ValueError("too many disks")
    for letter, target in zip(letters, mounts):
        target = Path(target)
        if not target.is_absolute():
            raise ValueError(f"disk mount must be absolute: {target}")
        target.mkdir(parents=True, exist_ok=True)
        subprocess.run(["mount", "-t", "ext4", "-o", "ro", f"/dev/vd{letter}", str(target)],
                       check=True)


def mount_volume(payload):
    """Mount the volume the host swapped in for the snapshot's placeholder drive."""
    device, target, size = payload["device"], Path(payload["mount"]), int(payload["size"])
    if not target.is_absolute():
        raise ValueError(f"volume mount must be absolute: {target}")
    deadline = time.monotonic() + 30
    with open(device, "rb") as block:
        while True:
            # BLKGETSIZE64: the new size shows once the guest sees the drive change.
            current = struct.unpack("Q", fcntl.ioctl(block, 0x80081272, b"\0" * 8))[0]
            if current == size:
                break
            if time.monotonic() > deadline:
                raise TimeoutError(f"{device} has {current} bytes, expected {size}")
            time.sleep(.02)
        fcntl.ioctl(block, 0x1261)  # BLKFLSBUF: forget blocks cached from the placeholder
    target.mkdir(parents=True, exist_ok=True)
    subprocess.run(["mount", "-t", "ext4", "-o", "rw,noatime", device, str(target)], check=True)
    if shutil.which("resize2fs"):
        # Grows the filesystem after the volume grew; a no-op otherwise.
        subprocess.run(["resize2fs", device], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)


def reseed(seed):
    """Mix host randomness into the kernel pool: every restored clone starts the same."""
    data = bytes.fromhex(seed)
    try:
        with open("/dev/urandom", "wb") as device:
            # RNDADDENTROPY, then RNDRESEEDCRNG so the new entropy is used at once.
            fcntl.ioctl(device, 0x40085203, struct.pack("ii", len(data) * 8, len(data)) + data)
            fcntl.ioctl(device, 0x5207)
    except OSError:
        pass


def start_executor():
    global executor_connection, executor_process
    if not executor_command:
        return None
    EXECUTOR_SOCKET.unlink(missing_ok=True)
    executor_process = subprocess.Popen(executor_command, stdin=subprocess.DEVNULL,
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    executor_connection = None
    return executor_process


def receive(connection, size):
    data = b""
    while len(data) < size:
        chunk = connection.recv(size - len(data))
        if not chunk:
            raise RuntimeError("executor closed the connection")
        data += chunk
    return data


def connect_executor():
    global executor_connection
    if executor_process is None or executor_process.poll() is not None:
        start_executor()
    if executor_process is None:
        raise RuntimeError("this pool has no executor")
    deadline = time.monotonic() + 10
    while True:
        try:
            executor_connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            executor_connection.connect(str(EXECUTOR_SOCKET))
            return executor_connection
        except OSError:
            executor_connection.close()
            executor_connection = None
            if executor_process.poll() is not None:
                raise RuntimeError(f"executor exited {executor_process.returncode}")
            if time.monotonic() >= deadline:
                raise TimeoutError("executor did not become ready")
            time.sleep(.01)


def executor_request(payload):
    global executor_connection
    data = json.dumps(payload).encode()
    with executor_lock:
        generation = executor_generation
        for attempt in range(2):
            try:
                connection = executor_connection or connect_executor()
                connection.sendall(len(data).to_bytes(4, "big") + data)
                return json.loads(receive(connection,
                                          int.from_bytes(receive(connection, 4), "big")))
            except (OSError, RuntimeError):
                if executor_connection:
                    executor_connection.close()
                executor_connection = None
                if attempt or generation != executor_generation:
                    raise


def abandon_executor_request():
    """After a restore, a request from before the snapshot has nobody to answer to.

    That happens when a suspended microVM resumes. Closing the executor connection
    ends the old request; the executor sees the close, and the next task connects anew.
    """
    global executor_generation
    if executor_lock.locked():
        executor_generation += 1
        connection = executor_connection
        if connection:
            try:
                connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass


def start_service():
    if not SERVICE.is_file():
        return None
    config = json.loads(SERVICE.read_text())
    command = config.get("entrypoint", []) + config.get("command", [])
    if not command:
        return None
    env = os.environ.copy()
    env.update(item.split("=", 1) for item in config.get("env", []) if "=" in item)
    return subprocess.Popen(command, cwd=config.get("working_dir") or "/", env=env)


def initialize(payload):
    """Configure the guest once, before the pool snapshot is taken."""
    global executor_command, initialized, service
    mount_disks(payload.get("disks") or [])
    executor_command = [str(part) for part in payload.get("executor") or []]
    start_executor()
    service = start_service()
    initialized = True


def handle(connection):
    for line in connection.makefile():
        try:
            payload = json.loads(line)
            if payload["encoding"] == "scraperack-snapshot":
                if "unix_time" in payload:
                    time.clock_settime(time.CLOCK_REALTIME, payload["unix_time"])
                if payload.get("seed"):
                    reseed(payload["seed"])
                if initialized:
                    abandon_executor_request()
                else:
                    initialize(payload)
                if service and service.poll() not in (None, 0):
                    raise RuntimeError(f"service exited {service.returncode}")
                if payload.get("preload"):
                    preloaded = executor_request({
                        "encoding": "scraperack-preload",
                        "modules": payload["preload"],
                    })
                    if preloaded["error"]:
                        raise RuntimeError(preloaded["error"])
                response = {
                    "result": {"value": {"encoding": "json", "data": {
                        "compatible": True,
                        "executor": bool(executor_command),
                        # The node may restore this guest with one scraperack-restore request.
                        "restore": 1,
                    }}, "stdout": "", "stderr": ""},
                    "error": None,
                    "timed_out": False,
                }
            elif payload["encoding"] == "scraperack-restore":
                # Everything a restored guest needs, in one round trip: each round trip
                # costs page faults in a freshly restored VM.
                time.clock_settime(time.CLOCK_REALTIME, payload["unix_time"])
                if payload.get("seed"):
                    reseed(payload["seed"])
                abandon_executor_request()
                if service and service.poll() not in (None, 0):
                    raise RuntimeError(f"service exited {service.returncode}")
                if payload.get("network"):
                    configure_network(payload["network"])
                if payload.get("preload"):
                    preload = {"encoding": "scraperack-preload", "modules": payload["preload"]}
                    if payload.get("url"):
                        preload["url"] = payload["url"]
                    preloaded = executor_request(preload)
                    if preloaded["error"]:
                        raise RuntimeError(preloaded["error"])
                response = {"result": None, "error": None, "timed_out": False}
            elif payload["encoding"] == "scraperack-network":
                configure_network(payload)
                response = {"result": None, "error": None, "timed_out": False}
            elif payload["encoding"] == "scraperack-volume":
                mount_volume(payload)
                response = {"result": None, "error": None, "timed_out": False}
            elif payload["encoding"] == "scraperack-sync":
                os.sync()
                response = {"result": None, "error": None, "timed_out": False}
            else:
                response = executor_request(payload)
        except BaseException:
            response = {
                "result": {"stdout": "", "stderr": ""},
                "error": traceback.format_exc(),
                "timed_out": False,
            }
        connection.sendall(json.dumps(response).encode() + b"\n")


def serve(connection):
    try:
        handle(connection)
    except OSError:
        pass  # the host went away, for example when the microVM was snapshotted
    finally:
        connection.close()


subprocess.run(["mount", "-t", "proc", "-o", "nosuid,nodev,noexec", "proc", "/proc"], check=True)
subprocess.run(["mount", "-t", "tmpfs", "-o", "mode=1777", "tmpfs", "/tmp"], check=True)
with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as control:
    interface = b"lo"
    ifreq = struct.pack("16sh22x", interface, 0)
    flags = struct.unpack("16sh22x", fcntl.ioctl(control, 0x8913, ifreq))[1]
    fcntl.ioctl(control, 0x8914, struct.pack("16sh22x", interface, flags | 1))
os.environ.update(HOME="/tmp", TMPDIR="/tmp", PYTHONDONTWRITEBYTECODE="1")
os.chdir("/tmp")
initialized = False
executor_command = []
executor_process = None
executor_connection = None
executor_lock = threading.Lock()
executor_generation = 0
service = None
server = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
server.bind((socket.VMADDR_CID_ANY, 5000))
server.listen(16)
while True:
    connection, _ = server.accept()
    threading.Thread(target=serve, args=(connection,), daemon=True).start()
