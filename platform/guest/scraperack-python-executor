#!/usr/bin/python3
import base64
import hashlib
import importlib
import io
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import traceback
import zipfile
from pathlib import Path

import cloudpickle

sys.path.insert(0, "/opt/scraperack/runtime")
import scraperack_runtime

SOCKET = Path("/tmp/scraperack-executor.sock")
FUNCTIONS = {}
WORKING_DIRS = Path("/tmp/scraperack-working-dirs")
STDOUT = tempfile.TemporaryFile(mode="w+")
STDERR = tempfile.TemporaryFile(mode="w+")


def encode(value):
    try:
        json.dumps(value)
        return {"encoding": "json", "data": value}
    except TypeError:
        return {
            "encoding": "cloudpickle",
            "data": base64.b64encode(cloudpickle.dumps(value)).decode(),
        }


def execute(payload):
    encoding = payload["encoding"]
    if encoding == "scraperack-preload":
        for module in payload.get("modules", []):
            loaded = importlib.import_module(module)
            if module == "requests":
                try:
                    loaded.get(payload.get("url", "http://127.0.0.1:1"), timeout=1)
                except loaded.RequestException:
                    pass
        return payload.get("modules", [])
    if encoding == "python-function":
        key = payload.get("cache_key", payload["hash"])
        if key not in FUNCTIONS:
            data = base64.b64decode(payload["function"])
            if hashlib.sha256(data).hexdigest() != payload["hash"]:
                raise ValueError("function hash does not match payload")
            FUNCTIONS[key] = cloudpickle.loads(data)
        params = cloudpickle.loads(base64.b64decode(payload["params"]))
        return FUNCTIONS[key](*params)
    if encoding == "cloudpickle":
        function, params = cloudpickle.loads(base64.b64decode(payload["data"]))
        return function(*params)
    if encoding == "python-source":
        namespace = {}
        exec(payload["source"], namespace)
        function = namespace.get("main")
        if not callable(function):
            raise ValueError("python-source must define main(...)")
        return function(*payload.get("params", []))
    if encoding == "files":
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            for name, data in payload["files"].items():
                path = Path(name)
                if path.is_absolute() or ".." in path.parts:
                    raise ValueError(f"invalid file path: {name}")
                target = root / path
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(base64.b64decode(data))
            command = payload["command"]
            process = subprocess.run(
                command, cwd=root, shell=isinstance(command, str), capture_output=True, text=True
            )
            if process.returncode:
                raise RuntimeError(f"command exited {process.returncode}\n{process.stderr}")
            return {
                "returncode": process.returncode,
                "stdout": process.stdout,
                "stderr": process.stderr,
            }
    if encoding == "json":
        return payload.get("data")
    raise ValueError(f"unknown payload encoding: {encoding}")


def prepare_working_dir(spec):
    if not spec:
        return None
    digest = spec["hash"]
    if len(digest) != 64 or any(character not in "0123456789abcdef" for character in digest):
        raise ValueError("invalid working directory hash")
    directory = WORKING_DIRS / digest
    if directory.is_dir():
        return directory
    archive = spec.get("archive")
    if archive is None:
        raise ValueError("working directory archive is missing")
    data = base64.b64decode(archive)
    if hashlib.sha256(data).hexdigest() != digest:
        raise ValueError("working directory hash does not match archive")
    WORKING_DIRS.mkdir(exist_ok=True)
    temporary = Path(tempfile.mkdtemp(dir=WORKING_DIRS))
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as bundle:
            for member in bundle.infolist():
                path = Path(member.filename)
                if path.is_absolute() or ".." in path.parts:
                    raise ValueError(f"invalid working directory path: {member.filename}")
            bundle.extractall(temporary)
        try:
            temporary.rename(directory)
        except FileExistsError:
            shutil.rmtree(temporary)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    return directory


def unload_modules(directory):
    if directory is None:
        return
    directory = directory.resolve()
    for name, module in list(sys.modules.items()):
        path = getattr(module, "__file__", None)
        if path:
            try:
                if Path(path).resolve().is_relative_to(directory):
                    del sys.modules[name]
            except (OSError, ValueError):
                pass


def handle(payload):
    if payload["encoding"] == "scraperack-describe":
        return {
            "result": {
                "value": {"encoding": "json", "data": f"Python {sys.version.split()[0]}"},
                "stdout": "",
                "stderr": "",
            },
            "error": None,
            "timed_out": False,
        }
    if payload["encoding"] == "scraperack-invocation":
        variables = payload.get("variables", {})
        secrets = payload.get("secrets", {})
        working_dir_spec = payload.get("working_dir")
        payload = payload["payload"]
    else:
        variables, secrets = {}, {}
        working_dir_spec = None
    context = scraperack_runtime._set_context(variables, secrets)
    environment = os.environ.copy()
    current_directory = Path.cwd()
    python_path = sys.path.copy()
    working_dir = None
    stdout, stderr = STDOUT, STDERR
    stdout.seek(0)
    stdout.truncate()
    stderr.seek(0)
    stderr.truncate()
    sys.stdout.flush()
    sys.stderr.flush()
    saved_stdout, saved_stderr = os.dup(1), os.dup(2)
    try:
        os.dup2(stdout.fileno(), 1)
        os.dup2(stderr.fileno(), 2)
        try:
            working_dir = prepare_working_dir(working_dir_spec)
            if working_dir is not None:
                os.chdir(working_dir)
                sys.path.insert(0, str(working_dir))
            value, error = encode(execute(payload)), None
        except BaseException:
            value, error = None, traceback.format_exc()
        sys.stdout.flush()
        sys.stderr.flush()
    finally:
        os.environ.clear()
        os.environ.update(environment)
        os.chdir(current_directory)
        sys.path[:] = python_path
        unload_modules(working_dir)
        scraperack_runtime._reset_context(context)
        os.dup2(saved_stdout, 1)
        os.dup2(saved_stderr, 2)
        os.close(saved_stdout)
        os.close(saved_stderr)
    stdout.seek(0)
    stderr.seek(0)
    return {
        "result": {"value": value, "stdout": stdout.read(), "stderr": stderr.read()},
        "error": error,
        "timed_out": False,
    }


SOCKET.unlink(missing_ok=True)
server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
server.bind(str(SOCKET))
server.listen(1)


def receive(connection, size):
    data = b""
    while len(data) < size:
        chunk = connection.recv(size - len(data))
        if not chunk:
            return None
        data += chunk
    return data


while True:
    connection, _ = server.accept()
    with connection:
        while header := receive(connection, 4):
            try:
                payload = json.loads(receive(connection, int.from_bytes(header, "big")))
                response = handle(payload)
            except BaseException:
                response = {
                    "result": {"value": None, "stdout": "", "stderr": ""},
                    "error": traceback.format_exc(),
                    "timed_out": False,
                }
            data = json.dumps(response).encode()
            connection.sendall(len(data).to_bytes(4, "big") + data)
