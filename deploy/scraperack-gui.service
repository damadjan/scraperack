[Unit]
Description=Scraperack management GUI
After=network-online.target scraperack-controller.service
Wants=network-online.target

[Service]
Type=simple
User=todor
WorkingDirectory=/home/todor/scraperack
Environment=SCRAPERACK_URL=http://127.0.0.1:7070
ExecStart=/home/todor/scraperack/.venv-gui/bin/python /home/todor/scraperack/gui/app.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
