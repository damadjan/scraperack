[Unit]
Description=Scraperack controller
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
User=todor
SupplementaryGroups=docker
Environment=RUST_LOG=info
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/local/bin/scraperack controller --listen 0.0.0.0:7070 --data-dir /var/lib/scraperack-controller
Restart=on-failure
RestartSec=1
LimitNOFILE=1048576
StateDirectory=scraperack-controller

[Install]
WantedBy=multi-user.target
